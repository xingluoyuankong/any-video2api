{
  "adapter": "src.channels.tiktok:TiktokChannel",
  "display_name": "TikTok Symphony (CUE)",
  "kind": "mixed",
  "base_url": "https://ads.tiktok.com",
  "proxy": "http://127.0.0.1:7897",
  "timeout": 120,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
  "transports": ["requests"],
  "supports": {
    "video": true,
    "image": true,
    "upload": true,
    "checkin": false,
    "oauth": false,
    "credits": false,
    "models": true,
    "verify": true
  },
  "models": {
    "seedance": "5000003",
    "seedance2": "5000005",
    "sora": "5000004",
    "veo": "5000002",
    "goku": "5000001",
    "runway": "4000004",
    "gemini": "gemini",
    "kontext": "kontext"
  },
  "endpoints": {
    "verify":       {"method": "GET",  "path": "/creative_bff_i18n/api/cue/get_miniapp_permission_with_allowlist"},
    "image_submit": {"method": "POST", "path": "/creative_bff_i18n/api/cue/i2v/submit_gen_task/gen_image"},
    "t2v_submit":   {"method": "POST", "path": "/creative_bff_i18n/api/cue/t2v/create_generate_task"},
    "i2v_submit":   {"method": "POST", "path": "/creative_bff_i18n/api/cue/i2v/create_generate_task"},
    "r2v_submit":   {"method": "POST", "path": "/creative_bff_i18n/api/cue/i2v/gen_r2v_video"},
    "poll":         {"method": "POST", "path": "/creative_bff_i18n/api/cue/generate-task/check"},
    "history":      {"method": "POST", "path": "/creative_bff_i18n/api/cue/history/tasks"},
    "upload_token": {"method": "POST", "path": "/creative_bff_i18n/api/cue/upload/token"}
  }
}
